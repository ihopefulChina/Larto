    {
      "name": "set_device",
      "title": "Set device",
      "description": "Switch the simulated device (reloads the page with the matching user agent).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "enum": [
              "iphone-13",
              "iphone-14-pro",
              "iphone-14-pro-max",
              "iphone-15",
              "iphone-15-plus",
              "iphone-16",
              "iphone-16-plus",
              "iphone-16-pro",
              "iphone-17-pro",
              "iphone-16-pro-max",
              "iphone-air",
              "iphone-13-mini",
              "iphone-13-pro-max",
              "iphone-12",
              "iphone-12-mini",
              "iphone-12-pro-max",
              "iphone-x",
              "iphone-11",
              "iphone-xs-max",
              "iphone-8",
              "iphone-8-plus",
              "nexus-5",
              "nexus-5x",
              "nexus-6",
              "ipad-pro",
              "ipad",
              "pc-mac",
              "pc-windows"
            ]
          }
        },
        "required": ["deviceId"]
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "set_zoom",
      "title": "Set zoom",
      "description": "Simulator zoom percentage. Allowed: 50, 75, 85, 100, 125, 150.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "zoom": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": ["zoom"]
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "set_theme",
      "title": "Set appearance",
      "description": "Switch app appearance.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["system", "light", "dark"]
          }
        },
        "required": ["mode"]
